<?xml version="1.0" encoding="utf-8"?>
<!--
  Inter, as one variable file exposed at the four weights this app uses.

  The system font is not bad — it is neutral to a fault, and a decade of Android
  has attached that neutrality to "generic Android app". Inter reads as software
  rather than as the platform, which is the difference this interface was missing
  once the surfaces and hierarchy were already right.

  Weights carry meaning here:
    400  descriptions, metadata
    500  body, controls
    600  names, buttons, list items, overlines
    700  the one title that owns a screen
  Android's "bold" is 700; most of what used to be bold wants 600, which has
  presence without the blunt weight the system font gives it.
-->
<font-family xmlns:android="http://schemas.android.com/apk/res/android">
    <font
        android:font="@font/inter_variable"
        android:fontStyle="normal"
        android:fontVariationSettings="'wght' 400"
        android:fontWeight="400" />
    <font
        android:font="@font/inter_variable"
        android:fontStyle="normal"
        android:fontVariationSettings="'wght' 500"
        android:fontWeight="500" />
    <font
        android:font="@font/inter_variable"
        android:fontStyle="normal"
        android:fontVariationSettings="'wght' 600"
        android:fontWeight="600" />
    <font
        android:font="@font/inter_variable"
        android:fontStyle="normal"
        android:fontVariationSettings="'wght' 700"
        android:fontWeight="700" />
</font-family>
