<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Dark is the app's home.

      The ladder carries a violet undertone rather than being neutral graphite.
      It is small on any single surface — a few points of blue and red over grey —
      and it is what makes the app feel like one product instead of black, grey
      and whatever colour the current space happens to be. Steps stay close
      together: depth is told by luminance, and big jumps read as stacked cards.

      Three roles, and they must not be mixed:
        - lavender  = Dual Space itself. Global actions, menus, settings.
        - the space colour = where you are right now. Header, dot, FAB, monogram.
        - the ladder = structure, and it never carries meaning.
    -->

    <!-- Surface ladder, darkest to lightest -->
    <color name="ds_bg">#0B0A11</color>
    <color name="ds_surface">#14131B</color>
    <color name="ds_surface_2">#1A1823</color>
    <color name="ds_surface_3">#211E2C</color>
    <color name="ds_surface_4">#2A2637</color>
    <color name="ds_scrim">#B3000000</color>

    <!-- Hairlines. Used sparingly: only to separate two surfaces of equal tone. -->
    <color name="ds_outline">#302C3E</color>
    <color name="ds_outline_strong">#413C52</color>

    <!--
      Interactive icons: grid, overflow, back, close, the per-row three-dot.

      They had been sharing ds_on_surface_faint with package names and
      descriptions, which made a live control look disabled. A thing you can tap
      must never carry the same weight as information you cannot — this sits
      above secondary text, because an available control should read as the
      brightest thing on a row that has no title.
    -->
    <color name="ds_icon">#D5D0DC</color>

    <!--
      Content emphasis. Three steps that have to be told apart at a glance, and
      the gaps between them are what stops the interface reading as one flat
      wash at 70% opacity. Hierarchy is carried here, by colour — never by
      View.alpha, which dims a whole subtree and cannot be reasoned about.

        primary    titles, names, the wordmark. Nearly white, and active.
        secondary  read immediately, but not a title. NOT disabled-looking.
        faint      package names, hints. Genuinely tertiary, never clickable.

      Secondary sat one step too close to faint, which is what produced the
      "everything is at 70% opacity" reading: the lines a user actually has to
      read — the app names, the space summary, the header status line — were
      carrying almost the same ink as metadata they may skip. It moves up, and
      only it. The distance to primary stays wide enough that a title is still
      obviously a title.
    -->
    <color name="ds_on_surface">#F3F0F7</color>
    <color name="ds_on_surface_muted">#C9C4D1</color>
    <color name="ds_on_surface_faint">#817B8D</color>
    <color name="ds_on_surface_disabled">#4E4A5A</color>

    <!--
      Overlines sit between secondary and faint on purpose: quieter than a line
      you must read, louder than metadata you may skip. Uppercase at 11sp needs
      that much to stay legible without announcing itself.
    -->
    <color name="ds_on_surface_overline">#928C9E</color>

    <!-- The product's own colour. A space's colour overrides this contextually. -->
    <color name="ds_accent">#9684FF</color>
    <color name="ds_accent_container">#1E1B2C</color>
    <color name="ds_on_accent">#0B0A11</color>

    <color name="ds_danger">#FF7A85</color>
    <color name="ds_danger_container">#2B1720</color>
    <color name="ds_success">#5FD3A0</color>

    <color name="ds_ripple">#24FFFFFF</color>
    <color name="ds_on_brand">#0B0A11</color>

    <!-- ==== Legacy names still referenced by older layouts ==== -->
    <color name="ds_surface_interactive">#211E2C</color>
    <color name="ds_glass">#D914131B</color>
    <color name="ds_border_hi">#302C3E</color>
    <color name="ds_border_lo">#241F30</color>
    <color name="ds_violet">#9684FF</color>
    <color name="ds_violet_soft">#1E1B2C</color>
    <color name="ds_blue">#7FA6FF</color>
    <color name="ds_blue_soft">#171E2E</color>
    <color name="primary">#9684FF</color>
    <color name="primary_dark">#0B0A11</color>
    <color name="primary_light">#B3A6FF</color>
    <color name="bg_top">#0B0A11</color>
    <color name="bg_bottom">#0B0A11</color>
    <color name="accent">#7FA6FF</color>
    <color name="accent_dark">#5B87E8</color>
    <color name="primary_text">#F3F0F7</color>
    <color name="secondary_text">#C9C4D1</color>
</resources>
