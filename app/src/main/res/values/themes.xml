<resources xmlns:tools="http://schemas.android.com/tools">

    <!--
      Single DayNight theme. Light values live here, dark ones in
      res/values-night/. Dark is the app default: App.onCreate() applies
      AppCompatDelegate.setDefaultNightMode() from the user's preference,
      which defaults to MODE_NIGHT_YES.
    -->
    <style name="Theme.BlackBox" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- One typeface for the whole app, named as a FILE rather than as a
             family. Every widget the framework inflates inherits Inter Regular;
             anything that needs another weight names its own file in type.xml.
             No weight in this app is resolved by lookup. -->
        <item name="android:fontFamily">@font/inter_regular</item>
        <item name="fontFamily">@font/inter_regular</item>
        <!-- The toolbar overflow is a popup like any other and has to look like
             one: without this it keeps the platform's sharp-cornered slab while
             every menu opened from code is rounded. -->
        <item name="actionOverflowMenuStyle">@style/DsPopupMenu.Popup</item>
        <item name="popupMenuStyle">@style/DsPopupMenu.Popup</item>
        <item name="colorPrimary">@color/ds_violet</item>
        <item name="colorPrimaryVariant">@color/ds_violet</item>
        <item name="colorOnPrimary">@color/ds_on_brand</item>

        <item name="colorSecondary">@color/ds_blue</item>
        <item name="colorSecondaryVariant">@color/ds_blue</item>
        <item name="colorOnSecondary">@color/ds_on_brand</item>

        <item name="colorAccent">@color/ds_violet</item>
        <item name="colorSurface">@color/ds_surface</item>
        <item name="colorOnSurface">@color/ds_on_surface</item>
        <item name="android:colorBackground">@color/ds_bg</item>
        <item name="colorError">@color/ds_danger</item>

        <item name="android:windowBackground">@color/ds_bg</item>
        <item name="android:statusBarColor" tools:targetApi="l">@color/ds_bg</item>
        <item name="android:navigationBarColor" tools:targetApi="l">@color/ds_bg</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">true</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">true</item>

        <item name="android:textColorPrimary">@color/ds_on_surface</item>
        <item name="android:textColorSecondary">@color/ds_on_surface_muted</item>
        <item name="actionMenuTextColor">@color/ds_on_surface</item>

        <!-- We ship a real dark theme; never let the OS auto-invert on top of it. -->
        <item name="android:forceDarkAllowed" tools:targetApi="q">false</item>

        <item name="alertDialogTheme">@style/Theme.BlackBox.AlertDialog</item>
        <item name="bottomSheetDialogTheme">@style/Theme.BlackBox.BottomSheet</item>
        <item name="materialAlertDialogTheme">@style/Theme.BlackBox.Dialog</item>
        <item name="preferenceTheme">@style/Theme.BlackBox.Preference</item>

        <!-- afollestad/material-dialogs theming -->
        <item name="md_background_color">@color/ds_surface</item>
        <item name="md_color_title">@color/ds_on_surface</item>
        <item name="md_color_content">@color/ds_on_surface_muted</item>
        <item name="md_color_button_text">@color/ds_violet</item>
        <item name="md_corner_radius">20dp</item>
        <item name="md_divider_color">@color/ds_outline</item>
    </style>

    <style name="Theme.BlackBox.BottomSheet" parent="Theme.MaterialComponents.DayNight.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/Widget.BlackBox.BottomSheet</item>
        <!-- Does not descend from Theme.BlackBox, so it never inherited the
             app typeface. -->
        <item name="fontFamily">@font/inter_regular</item>
        <item name="android:fontFamily">@font/inter_regular</item>
        <item name="colorPrimary">@color/ds_violet</item>
        <item name="colorAccent">@color/ds_violet</item>
        <!-- Edge-to-edge would draw the sheet behind the navigation bar and cut
             off its last row; keep the sheet inside the system insets. -->
        <item name="enableEdgeToEdge">false</item>
    </style>

    <style name="Widget.BlackBox.BottomSheet" parent="Widget.MaterialComponents.BottomSheet.Modal">
        <item name="backgroundTint">@android:color/transparent</item>
        <item name="android:background">@android:color/transparent</item>
    </style>

    <style name="Theme.BlackBox.AlertDialog" parent="Theme.MaterialComponents.DayNight.Dialog.Alert">
        <!-- Does not descend from Theme.BlackBox, so it never inherited the
             app typeface. -->
        <item name="fontFamily">@font/inter_regular</item>
        <item name="android:fontFamily">@font/inter_regular</item>
        <item name="colorPrimary">@color/ds_violet</item>
        <item name="colorAccent">@color/ds_violet</item>
        <item name="colorSurface">@color/ds_surface</item>
        <item name="colorOnSurface">@color/ds_on_surface</item>
        <item name="android:background">@color/ds_surface</item>
        <item name="android:textColorPrimary">@color/ds_on_surface</item>
        <item name="android:textColorSecondary">@color/ds_on_surface_muted</item>
    </style>

    <style name="Theme.BlackBox.Dialog" parent="ThemeOverlay.MaterialComponents.MaterialAlertDialog">
        <!-- Does not descend from Theme.BlackBox, so it never inherited the
             app typeface. -->
        <item name="fontFamily">@font/inter_regular</item>
        <item name="android:fontFamily">@font/inter_regular</item>
        <item name="colorSurface">@color/ds_surface</item>
        <item name="colorOnSurface">@color/ds_on_surface</item>
        <item name="colorPrimary">@color/ds_violet</item>
    </style>

    <style name="Theme.BlackBox.Preference" parent="PreferenceThemeOverlay">
        <item name="android:textColorPrimary">@color/ds_on_surface</item>
        <item name="android:textColorSecondary">@color/ds_on_surface_muted</item>
        <!-- Category titles default to the accent, which made four bright violet
             headings the loudest thing on a screen of quiet rows. They are
             overlines here: small, spaced, faint. -->
        <item name="preferenceCategoryTitleTextAppearance">@style/DsText.Overline</item>
        <!-- Sections are separated by space, not by a rule across the screen. -->
        <item name="android:divider">@null</item>
        <item name="android:dividerHeight">0dp</item>
        <item name="allowDividerAbove">false</item>
        <item name="allowDividerBelow">false</item>
        <item name="preferenceCategoryStyle">@style/DsPreferenceCategory</item>
        <item name="preferenceStyle">@style/DsPreference</item>
        <item name="switchPreferenceCompatStyle">@style/DsPreference.Switch</item>
        <!-- Each preference kind resolves its own style attribute; miss one and
             that single row keeps the library's borderless layout. -->
        <item name="dialogPreferenceStyle">@style/DsPreference.Dialog</item>
        <item name="checkBoxPreferenceStyle">@style/DsPreference.Switch</item>
    </style>

    <style name="DsPreference" parent="Preference.Material">
        <item name="android:layout">@layout/preference_item_ds</item>
        <item name="allowDividerAbove">false</item>
        <item name="allowDividerBelow">false</item>
        <item name="iconSpaceReserved">false</item>
    </style>

    <style name="DsPreference.Dialog" parent="Preference.DialogPreference.Material">
        <item name="android:layout">@layout/preference_item_ds</item>
        <item name="allowDividerAbove">false</item>
        <item name="allowDividerBelow">false</item>
        <item name="iconSpaceReserved">false</item>
    </style>

    <style name="DsPreference.Switch" parent="Preference.SwitchPreferenceCompat.Material">
        <item name="android:layout">@layout/preference_item_ds</item>
        <item name="allowDividerAbove">false</item>
        <item name="allowDividerBelow">false</item>
        <item name="iconSpaceReserved">false</item>
    </style>

    <style name="DsPreferenceCategory" parent="Preference.Category.Material">
        <item name="android:layout">@layout/preference_category_ds</item>
        <item name="allowDividerAbove">false</item>
        <item name="allowDividerBelow">false</item>
    </style>

    <!-- ===== Type scale ===== -->

    <!--
      Every Material TextAppearance sets BOTH spellings of fontFamily to a
      sans-serif value, and AppCompat reads the unprefixed one first. Overriding
      only android:fontFamily leaves the parent's Roboto in the slot that wins.
      Headline6 additionally sets textStyle=bold, which synthesises weight on top
      of a static face that already carries it. Every style below therefore
      names the file twice and resets textStyle.
    -->
    <style name="Text.Title" parent="TextAppearance.MaterialComponents.Headline6">
        <item name="fontFamily">@font/inter_semibold</item>
        <item name="android:fontFamily">@font/inter_semibold</item>
        <item name="android:textStyle">normal</item>
        <item name="android:textSize">20sp</item>
        <item name="android:textColor">@color/ds_on_surface</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <style name="Text.Body" parent="TextAppearance.MaterialComponents.Body2">
        <item name="fontFamily">@font/inter_regular</item>
        <item name="android:fontFamily">@font/inter_regular</item>
        <item name="android:textStyle">normal</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/ds_on_surface</item>
    </style>

    <style name="Text.Caption" parent="TextAppearance.MaterialComponents.Caption">
        <item name="fontFamily">@font/inter_regular</item>
        <item name="android:fontFamily">@font/inter_regular</item>
        <item name="android:textStyle">normal</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/ds_on_surface_muted</item>
    </style>

    <style name="Text.SectionHeader" parent="TextAppearance.MaterialComponents.Overline">
        <item name="fontFamily">@font/inter_semibold</item>
        <item name="android:fontFamily">@font/inter_semibold</item>
        <item name="android:textStyle">normal</item>
        <item name="android:textSize">12sp</item>
        <item name="android:letterSpacing">0.04</item>
        <item name="android:textColor">@color/ds_on_surface_overline</item>
        <item name="android:textAllCaps">true</item>
    </style>

    <!--
      The wordmark. It is the product's name and must read as branding, so it
      takes the primary foreground at full opacity — never metadata's tone, and
      never less presence than the current space's name sitting below it.

      600, not the framework's bold: at 700 Inter reads as a bold toolbar label
      rather than a name. Presence comes from luminance and the right weight,
      not from size or colour.
    -->
    <!--
      Two things arrive from Base.TextAppearance.MaterialComponents.Headline6 and
      have to be shut off by name, because overriding android:fontFamily alone
      does not reach either of them:

        fontFamily = sans-serif-medium   the UNPREFIXED attribute. AppCompat
            reads TextAppearance_fontFamily before TextAppearance_android_fontFamily,
            so the parent's Roboto won and the wordmark was the one title in the
            app not drawn in Inter.
        android:textStyle = bold         a synthetic-bold request layered on top
            of whichever face won. Smeared glyphs, no real 700 involved.

      This is the "indirect resolution" the rest of the type scale already
      avoids: DsText.Display has no Material parent, and the space name sets the
      attribute on the view. The wordmark was the only one inheriting.
    -->
    <style name="ToolbarTitle" parent="TextAppearance.MaterialComponents.Headline6">
        <item name="fontFamily">@font/inter_semibold</item>
        <item name="android:fontFamily">@font/inter_semibold</item>
        <item name="android:textStyle">normal</item>
        <item name="android:textSize">20sp</item>
        <item name="android:textColor">@color/ds_on_surface</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <!--
      The status line under it. Clearly secondary to the wordmark, and just as
      clearly not disabled: full opacity on the secondary token, no alpha.
    -->
    <style name="ToolbarSubtitle" parent="TextAppearance.MaterialComponents.Body2">
        <item name="fontFamily">@font/inter_regular</item>
        <item name="android:fontFamily">@font/inter_regular</item>
        <item name="android:textStyle">normal</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/ds_on_surface_muted</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <style name="ToolBarColorStyle" parent="ThemeOverlay.MaterialComponents.Toolbar.Surface">
        <item name="actionMenuTextColor">@color/ds_on_surface</item>
        <item name="colorControlNormal">@color/ds_icon</item>
        <item name="android:forceDarkAllowed" tools:targetApi="q">false</item>
    </style>

    <style name="WelcomeTheme" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Does not descend from Theme.BlackBox, so it never inherited the
             app typeface. -->
        <item name="fontFamily">@font/inter_regular</item>
        <item name="android:fontFamily">@font/inter_regular</item>
        <item name="android:windowBackground">@drawable/splash</item>
        <item name="android:statusBarColor" tools:targetApi="l">@color/ds_bg</item>
        <item name="android:navigationBarColor" tools:targetApi="l">@color/ds_bg</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">true</item>
        <item name="android:forceDarkAllowed" tools:targetApi="q">false</item>
    </style>

    <!--
      Tema invisível para a Activity-ponte (OpenSpaceActivity): sem UI, sem flash.
      A ponte abre o clone e encerra; o guest cobre a tela em seguida.
    -->
    <style name="Theme.BlackBox.Invisible" parent="Theme.BlackBox">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:backgroundDimEnabled">false</item>
        <item name="android:windowAnimationStyle">@null</item>
    </style>

</resources>
