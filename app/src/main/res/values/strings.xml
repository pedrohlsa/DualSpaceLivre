    <string name="about_title">Sobre o MultiSpace</string>
    <string name="about_summary">Versão, como funciona e privacidade</string>
    <string name="about_version">Versão %s</string>
    <string name="about_description">Rode várias contas do mesmo aplicativo, cada uma no seu próprio espaço isolado. Sem anúncios e sem rastreadores.</string>
    <string name="about_how_section">Como funciona</string>
    <string name="about_how_body">Cada espaço é um ambiente virtual completo: armazenamento, contas e identificadores próprios. Os apps clonados rodam dentro deste aplicativo, sem precisar criar perfis extras no Android.</string>
    <string name="about_privacy_section">Privacidade</string>
    <string name="about_privacy_body">Nada é enviado para servidores nossos. Não há anúncios, análise de uso nem rastreadores. Os dados de cada espaço ficam só no seu aparelho e são apagados junto com o espaço.</string>
    <string name="about_credits">Baseado no motor de virtualização de código aberto BlackBox / VirtualApp.</string>

