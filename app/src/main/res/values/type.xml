<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      One type scale for the whole app.
      Hierarchy is carried by size, weight AND colour together — a screen where
      everything is bold white has no hierarchy at all. Body text sits on
      ds_on_surface, supporting text drops to ds_on_surface_muted, and metadata
      drops again to ds_on_surface_faint. Letter spacing tightens as size grows,
      which is what keeps a large title from looking like a banner.
    -->

    <style name="DsText">
        <item name="android:textColor">@color/ds_on_surface</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:fontFamily">@font/inter</item>
        <item name="android:textFontWeight">400</item>
    </style>

    <!-- Screen owner. One per screen, never two. -->
    <style name="DsText.Display">
        <item name="android:textSize">28sp</item>
        <item name="android:letterSpacing">-0.02</item>
        <item name="android:lineSpacingMultiplier">1.05</item>
            <item name="android:textFontWeight">700</item>
</style>

    <!-- Title of a sheet or dialog. -->
    <style name="DsText.Title">
        <item name="android:textSize">20sp</item>
        <item name="android:letterSpacing">-0.015</item>
            <item name="android:textFontWeight">700</item>
</style>

    <!-- The name of a thing in a list: a space, an app. -->
    <style name="DsText.Item">
        <item name="android:textSize">16sp</item>
        <item name="android:letterSpacing">-0.01</item>
            <item name="android:textFontWeight">600</item>
</style>

    <style name="DsText.Body">
        <item name="android:textSize">14sp</item>
        <item name="android:textFontWeight">500</item>
    </style>

    <!-- Second line of a row: counts, status, description. -->
    <style name="DsText.Support">
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/ds_on_surface_muted</item>
    </style>

    <!-- Section headers and overlines. Small, spaced, quiet. -->
    <style name="DsText.Overline">
        <item name="android:textSize">11sp</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:textColor">@color/ds_on_surface_faint</item>
            <item name="android:textFontWeight">600</item>
</style>

    <!-- Metadata that must not compete: "Espaço 2 de 8". -->
    <style name="DsText.Meta">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/ds_on_surface_faint</item>
    </style>

    <!-- Text inside a button or a tappable row action. -->
    <style name="DsText.Action">
        <item name="android:textSize">14sp</item>
        <item name="android:letterSpacing">0.01</item>
            <item name="android:textFontWeight">600</item>
</style>

    <!-- App name under an icon in the grid. Two lines maximum. -->
    <!--
      Set explicitly rather than inherited. An app name is the one label whose
      typeface is easy to get wrong by accident: the adapter reassigns its size at
      runtime, and a style that only inherits is one refactor away from silently
      falling back to the platform font. 400 keeps it from competing with the
      space name above it.
    -->
    <style name="DsText.AppLabel">
        <item name="android:fontFamily">@font/inter</item>
        <item name="android:textFontWeight">500</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/ds_on_surface_muted</item>
        <item name="android:maxLines">2</item>
        <item name="android:ellipsize">end</item>
        <item name="android:gravity">center_horizontal</item>
        <item name="android:lineSpacingMultiplier">1.1</item>
    </style>

    <!--
      Context menus. The platform default is a sharp-cornered slab that belongs
      to a different decade of Android than the rest of this app; this gives it
      the same surface and radius as everything else it opens over.
    -->
    <style name="DsPopupMenu" parent="Theme.MaterialComponents.DayNight">
        <!-- Both spellings: androidx resolves the unprefixed attribute, the
             framework the prefixed one, and which is consulted depends on how the
             popup ends up being inflated. -->
        <item name="popupMenuStyle">@style/DsPopupMenu.Popup</item>
        <item name="android:popupMenuStyle">@style/DsPopupMenu.Popup</item>
        <item name="android:textColorPrimary">@color/ds_on_surface</item>
        <item name="android:colorBackground">@color/ds_surface_3</item>
    </style>

    <style name="DsPopupMenu.Popup" parent="Widget.MaterialComponents.PopupMenu">
        <item name="android:popupBackground">@drawable/bg_menu</item>
        <item name="android:popupElevation">12dp</item>
        <item name="android:overlapAnchor">true</item>
        <!-- The platform pads menu rows for a list that spans the screen. Four
             short actions in a floating popup do not need that much air. -->
        <item name="listPreferredItemPaddingLeft">@dimen/sp_4</item>
        <item name="listPreferredItemPaddingRight">@dimen/sp_4</item>
        <item name="android:listPreferredItemPaddingLeft">@dimen/sp_4</item>
        <item name="android:listPreferredItemPaddingRight">@dimen/sp_4</item>
    </style>
</resources>
