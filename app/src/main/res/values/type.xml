<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      One type scale for the whole app.

      Every style names its font FILE, never a family plus a requested weight.
      A family lookup is one indirection too many: a style that asked for 600
      resolved to 400 on the device more than once, and nothing in the XML says
      so. `@font/inter_semibold` cannot be resolved into something else.

        inter_regular   400  descriptions, metadata, secondary lines
        inter_medium    500  app names, menu rows, controls that need presence
        inter_semibold  600  titles, names, actions, overlines

      Bold 700 is deliberately unused. The interface improved when it left, and
      a weight nothing needs is a weight that gets misapplied later.

      Hierarchy is size AND weight AND colour together — a screen where
      everything is bold white has no hierarchy at all. Sizes and tracking here
      are approved as they stand; this file changes weight and colour only.
    -->

    <!--
      Both spellings of the attribute, everywhere. AppCompat reads the
      unprefixed `fontFamily` before `android:fontFamily`, so a style that sets
      only the prefixed one can still be overruled by whatever a parent style
      left in the other slot.
    -->
    <style name="DsText">
        <item name="android:textColor">@color/ds_on_surface</item>
        <item name="android:includeFontPadding">false</item>
        <item name="fontFamily">@font/inter_regular</item>
        <item name="android:fontFamily">@font/inter_regular</item>
    </style>

    <!-- Screen owner: "Bem-vindo". 600, not 700 — presence without the slab. -->
    <style name="DsText.Display">
        <item name="fontFamily">@font/inter_semibold</item>
        <item name="android:fontFamily">@font/inter_semibold</item>
        <item name="android:textSize">28sp</item>
        <item name="android:letterSpacing">-0.02</item>
        <item name="android:lineSpacingMultiplier">1.05</item>
    </style>

    <!-- Title of a sheet or dialog: "Seus espaços", "Configurações". -->
    <style name="DsText.Title">
        <item name="fontFamily">@font/inter_semibold</item>
        <item name="android:fontFamily">@font/inter_semibold</item>
        <item name="android:textSize">20sp</item>
        <item name="android:letterSpacing">-0.015</item>
    </style>

    <!-- The name of a thing in a list: a space, a setting. -->
    <style name="DsText.Item">
        <item name="fontFamily">@font/inter_semibold</item>
        <item name="android:fontFamily">@font/inter_semibold</item>
        <item name="android:textSize">16sp</item>
        <item name="android:letterSpacing">-0.01</item>
    </style>

    <!-- Menu rows, popover entries, controls that need presence but not rank. -->
    <style name="DsText.Body">
        <item name="fontFamily">@font/inter_medium</item>
        <item name="android:fontFamily">@font/inter_medium</item>
        <item name="android:textSize">14sp</item>
    </style>

    <!--
      Second line of a row: counts, status, description. Regular weight and the
      secondary tone — it has to be read immediately, so it is not metadata and
      never wears the faint token.
    -->
    <style name="DsText.Support">
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/ds_on_surface_muted</item>
    </style>

    <!--
      Section headers and overlines. Small, spaced, quiet — but quiet is not
      disabled, so they sit on their own token between secondary and faint.
      Tracking stays at 0.04: at 0.08 it read as spaced-out rather than a label.
    -->
    <style name="DsText.Overline">
        <item name="fontFamily">@font/inter_semibold</item>
        <item name="android:fontFamily">@font/inter_semibold</item>
        <item name="android:textSize">11sp</item>
        <item name="android:letterSpacing">0.04</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:textColor">@color/ds_on_surface_overline</item>
    </style>

    <!-- Metadata that must not compete: "Espaço 2 de 8", package names. -->
    <style name="DsText.Meta">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/ds_on_surface_faint</item>
    </style>

    <!-- Text inside a button or a tappable row action. -->
    <style name="DsText.Action">
        <item name="fontFamily">@font/inter_semibold</item>
        <item name="android:fontFamily">@font/inter_semibold</item>
        <item name="android:textSize">14sp</item>
        <item name="android:letterSpacing">0.01</item>
    </style>

    <!--
      App name under an icon in the grid. The adapter reassigns its size at bind
      time, so everything else is pinned here explicitly. Medium, on the
      secondary tone: it must read as part of the interface rather than as a
      caption, without competing with the space name above it.
    -->
    <style name="DsText.AppLabel">
        <item name="fontFamily">@font/inter_medium</item>
        <item name="android:fontFamily">@font/inter_medium</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/ds_on_surface_muted</item>
        <item name="android:maxLines">2</item>
        <item name="android:ellipsize">end</item>
        <item name="android:gravity">center_horizontal</item>
        <item name="android:lineSpacingMultiplier">1.1</item>
    </style>

    <!--
      Context menus. The platform default is a sharp-cornered slab that belongs
      to a different decade of Android than the rest of this app; this gives it
      the same surface and radius as everything else it opens over.
    -->
    <style name="DsPopupMenu" parent="Theme.MaterialComponents.DayNight">
        <!-- Does not descend from Theme.BlackBox, so it never inherited the app
             typeface: menu rows are inflated against this theme. -->
        <item name="fontFamily">@font/inter_regular</item>
        <item name="android:fontFamily">@font/inter_regular</item>
        <!-- Both spellings: androidx resolves the unprefixed attribute, the
             framework the prefixed one, and which is consulted depends on how the
             popup ends up being inflated. -->
        <item name="popupMenuStyle">@style/DsPopupMenu.Popup</item>
        <item name="android:popupMenuStyle">@style/DsPopupMenu.Popup</item>
        <item name="android:textColorPrimary">@color/ds_on_surface</item>
        <item name="android:colorBackground">@color/ds_surface_3</item>
    </style>

    <style name="DsPopupMenu.Popup" parent="Widget.MaterialComponents.PopupMenu">
        <item name="android:popupBackground">@drawable/bg_menu</item>
        <item name="android:popupElevation">12dp</item>
        <item name="android:overlapAnchor">true</item>
        <!-- The platform pads menu rows for a list that spans the screen. Four
             short actions in a floating popup do not need that much air. -->
        <item name="listPreferredItemPaddingLeft">@dimen/sp_4</item>
        <item name="listPreferredItemPaddingRight">@dimen/sp_4</item>
        <item name="android:listPreferredItemPaddingLeft">@dimen/sp_4</item>
        <item name="android:listPreferredItemPaddingRight">@dimen/sp_4</item>
    </style>
</resources>
