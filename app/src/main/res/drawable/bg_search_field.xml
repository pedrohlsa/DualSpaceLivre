<?xml version="1.0" encoding="utf-8"?>
<!--
  Text fields keep their outline: an input has to look like something you can
  type into, and here the hairline is doing real work rather than decorating.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/ds_surface_2" />
    <corners android:radius="@dimen/radius_sm" />
    <stroke android:width="@dimen/hairline" android:color="@color/ds_outline" />
</shape>
