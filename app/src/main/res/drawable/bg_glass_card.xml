<?xml version="1.0" encoding="utf-8"?>
<!--
  Was a translucent fill under a gradient hairline. It is a plain surface now:
  depth on this app comes from the luminance ladder, and a border around every
  card was what made the old interface read as a wireframe of itself.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/ds_surface_2" />
    <corners android:radius="@dimen/radius_lg" />
</shape>
