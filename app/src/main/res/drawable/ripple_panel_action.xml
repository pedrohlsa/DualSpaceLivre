<?xml version="1.0" encoding="utf-8"?>
<!-- Compact action living inside a panel header. Tonal, product lavender. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/ds_ripple">
    <item android:id="@android:id/mask">
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFFFF" />
            <corners android:radius="@dimen/radius_sm" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/ds_accent_container" />
            <corners android:radius="@dimen/radius_sm" />
            <stroke android:width="@dimen/hairline" android:color="@color/ds_outline" />
        </shape>
    </item>
</ripple>
