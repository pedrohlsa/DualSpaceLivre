<?xml version="1.0" encoding="utf-8"?>
<!--
  Kept for anything that still wants a container behind a glyph. App icons no
  longer use it: an adaptive icon carries its own shape, and boxing it produced
  a slab with an icon floating inside.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/ds_surface_3" />
    <corners android:radius="@dimen/radius_md" />
</shape>
