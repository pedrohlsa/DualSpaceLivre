<?xml version="1.0" encoding="utf-8"?>
<!--
  One space in the "Seus espaços" sheet.

  A neutral row. The space colour appears in exactly two places: the monogram
  behind the initial, and a trace of tint on the row when it is the current one.
  The monogram matters more than it looks — with eight spaces, several colours
  end up close together, and a letter tells them apart when a colour cannot.
  Status is never colour alone: the current space also says so in words.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        xmlns:tools="http://schemas.android.com/tools"
        android:id="@+id/spaceRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/sp_1"
        android:gravity="center_vertical"
        android:minHeight="72dp"
        android:orientation="horizontal"
        android:paddingStart="@dimen/sp_3"
        android:paddingTop="@dimen/sp_2"
        android:paddingEnd="@dimen/sp_1"
        android:paddingBottom="@dimen/sp_2"
        android:stateListAnimator="@animator/press_scale">

    <FrameLayout
            android:layout_width="@dimen/avatar_md"
            android:layout_height="@dimen/avatar_md"
            android:layout_marginEnd="@dimen/sp_3">

        <!-- Tonal container in the space colour; filled from code. -->
        <View
                android:id="@+id/spaceChip"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

        <TextView
                android:id="@+id/spaceMonogram"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:includeFontPadding="false"
                android:textSize="17sp"
                android:textStyle="bold"
                tools:text="T" />
    </FrameLayout>

    <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

        <TextView
                android:id="@+id/spaceName"
                style="@style/DsText.Item"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                tools:text="Julia (Trans)" />

        <TextView
                android:id="@+id/spaceSummary"
                style="@style/DsText.Support"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="1"
                tools:text="3 aplicativos" />
    </LinearLayout>

    <TextView
            android:id="@+id/spaceActive"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/sp_1"
            android:includeFontPadding="false"
            android:letterSpacing="0.06"
            android:paddingStart="@dimen/sp_2"
            android:paddingTop="3dp"
            android:paddingEnd="@dimen/sp_2"
            android:paddingBottom="3dp"
            android:text="@string/space_active"
            android:textSize="10sp"
            android:textStyle="bold"
            android:visibility="gone"
            tools:visibility="visible" />

    <!-- 48dp target around a 20dp glyph: the icon looks small, the tap area is not. -->
    <ImageView
            android:id="@+id/spaceMenu"
            android:layout_width="@dimen/touch_min"
            android:layout_height="@dimen/touch_min"
            android:background="@drawable/ripple_transparent_16"
            android:contentDescription="@string/space_options"
            android:padding="14dp"
            android:src="@drawable/ic_more_vert"
            app:tint="@color/ds_on_surface_faint" />

</LinearLayout>
