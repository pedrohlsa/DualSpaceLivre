<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        xmlns:tools="http://schemas.android.com/tools"
        android:id="@+id/spaceRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:minHeight="76dp"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingTop="12dp"
        android:paddingEnd="8dp"
        android:paddingBottom="12dp"
        android:stateListAnimator="@animator/press_scale">

    <!-- Colour chip: a rounded square gradient in the space colour, tinted from
         code. Reads much stronger than a plain dot at this size. -->
    <View
            android:id="@+id/spaceChip"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginEnd="14dp" />

    <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

        <TextView
                android:id="@+id/spaceName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:letterSpacing="-0.01"
                android:maxLines="1"
                android:textColor="@color/ds_on_surface"
                android:textSize="18sp"
                android:textStyle="bold"
                tools:text="Trabalho" />

        <TextView
                android:id="@+id/spaceSummary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/ds_on_surface_muted"
                android:textSize="13sp"
                tools:text="3 aplicativos" />
    </LinearLayout>

    <TextView
            android:id="@+id/spaceActive"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:letterSpacing="0.08"
            android:paddingStart="10dp"
            android:paddingTop="4dp"
            android:paddingEnd="10dp"
            android:paddingBottom="4dp"
            android:text="@string/space_active"
            android:textSize="10sp"
            android:textStyle="bold"
            android:visibility="gone" />

    <ImageView
            android:id="@+id/spaceMenu"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/ripple_transparent_16"
            android:contentDescription="@string/space_options"
            android:padding="8dp"
            android:src="@drawable/ic_more_vert"
            app:tint="@color/ds_on_surface_faint" />

</LinearLayout>
