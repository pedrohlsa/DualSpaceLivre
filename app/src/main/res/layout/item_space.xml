<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        xmlns:tools="http://schemas.android.com/tools"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:background="@drawable/ripple_card_2"
        android:gravity="center_vertical"
        android:minHeight="66dp"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="10dp"
        android:paddingEnd="8dp"
        android:paddingBottom="10dp">

    <View
            android:id="@+id/spaceDot"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginEnd="16dp"
            android:background="@drawable/bg_dot" />

    <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

        <TextView
                android:id="@+id/spaceName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/ds_on_surface"
                android:textSize="16sp"
                android:textStyle="bold"
                tools:text="Trabalho" />

        <TextView
                android:id="@+id/spaceSummary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/ds_on_surface_muted"
                android:textSize="13sp"
                tools:text="3 aplicativos" />
    </LinearLayout>

    <ImageView
            android:id="@+id/spaceActive"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_marginEnd="4dp"
            android:contentDescription="@string/space_active"
            android:src="@drawable/ic_check_24"
            android:visibility="gone"
            app:tint="@color/ds_success" />

    <ImageView
            android:id="@+id/spaceMenu"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/ripple_transparent_16"
            android:contentDescription="@string/space_options"
            android:padding="8dp"
            android:src="@drawable/ic_more_vert"
            app:tint="@color/ds_on_surface_muted" />

</LinearLayout>
