<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        xmlns:tools="http://schemas.android.com/tools"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/ds_bg"
        tools:context=".view.main.MainActivity">

    <!-- Ambient light in the current space's colour. Tinted and crossfaded from
         MainActivity whenever the space changes, so the whole screen carries the
         identity of the space you are in. -->
    <View
            android:id="@+id/glow"
            android:layout_width="0dp"
            android:layout_height="340dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

    <include
            android:id="@+id/toolbar_layout"
            layout="@layout/view_toolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toTopOf="parent" />

    <!-- Hero: the space you are in, big enough to be the subject of the screen.
         Tapping anywhere on it opens the space picker. -->
    <LinearLayout
            android:id="@+id/spaceHeader"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="6dp"
            android:layout_marginEnd="16dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="20dp"
            android:paddingTop="18dp"
            android:paddingEnd="16dp"
            android:paddingBottom="18dp"
            android:stateListAnimator="@animator/press_scale"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/toolbar_layout">

        <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

            <TextView
                    android:id="@+id/spaceOverline"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.14"
                    android:text="@string/current_space"
                    android:textAllCaps="true"
                    android:textColor="@color/ds_on_surface_faint"
                    android:textSize="11sp"
                    android:textStyle="bold" />

            <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                <View
                        android:id="@+id/spaceDot"
                        android:layout_width="13dp"
                        android:layout_height="13dp"
                        android:layout_marginEnd="11dp"
                        android:background="@drawable/bg_dot" />

                <TextView
                        android:id="@+id/spaceName"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:letterSpacing="-0.02"
                        android:maxLines="1"
                        android:textColor="@color/ds_on_surface"
                        android:textSize="27sp"
                        android:textStyle="bold"
                        tools:text="Trabalho" />
            </LinearLayout>

            <TextView
                    android:id="@+id/spaceSummary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/ds_on_surface_muted"
                    android:textSize="13sp"
                    tools:text="3 aplicativos · Espaço 1 de 2" />
        </LinearLayout>

        <ImageView
                android:id="@+id/spaceChevron"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_marginStart="8dp"
                android:contentDescription="@string/switch_space"
                android:src="@drawable/ic_chevron_down"
                app:tint="@color/ds_on_surface_muted" />
    </LinearLayout>

    <androidx.viewpager2.widget.ViewPager2
            android:id="@+id/viewPager"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="10dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@id/spaceHeader" />

    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
            android:id="@+id/fab"
            android:layout_width="wrap_content"
            android:layout_height="56dp"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="22dp"
            android:contentDescription="@string/add_app"
            android:text="@string/add_app"
            android:textAllCaps="false"
            android:textSize="15sp"
            android:textStyle="bold"
            app:cornerRadius="20dp"
            app:elevation="10dp"
            app:icon="@drawable/ic_add_24"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintRight_toRightOf="parent" />

    <!-- Welcome screen, shown over everything on launch when there is more than
         one space. Horizontal carousel instead of a vertical list: picking an
         account should feel like choosing a card, not scrolling a menu. -->
    <FrameLayout
            android:id="@+id/welcomeOverlay"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="@color/ds_bg"
            android:clickable="true"
            android:elevation="24dp"
            android:focusable="true"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

        <View
                android:id="@+id/welcomeGlow"
                android:layout_width="match_parent"
                android:layout_height="220dp" />

        <!-- Close: entering the app must never be a dead end. -->
        <ImageView
                android:id="@+id/welcomeClose"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:layout_gravity="top|end"
                android:layout_marginTop="12dp"
                android:layout_marginEnd="12dp"
                android:background="@drawable/ripple_transparent_16"
                android:contentDescription="@string/cancel"
                android:padding="12dp"
                android:src="@drawable/ic_close_24"
                app:tint="@color/ds_on_surface_muted" />

        <!--
          Header sits at the top and the grid takes the room that is left. The
          old layout centred everything, which left a band of dead space above
          and below however many spaces existed.
        -->
        <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:paddingTop="72dp">

            <TextView
                    android:id="@+id/welcomeTitle"
                    style="@style/DsText.Display"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="@dimen/gutter"
                    android:paddingEnd="@dimen/gutter"
                    android:text="@string/welcome_title"
                    android:textSize="32sp" />

            <TextView
                    android:id="@+id/welcomeSubtitle"
                    style="@style/DsText.Support"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/sp_1"
                    android:paddingStart="@dimen/gutter"
                    android:paddingEnd="@dimen/gutter"
                    android:text="@string/welcome_subtitle"
                    android:textSize="14sp" />

            <!--
              Two columns, flowing downwards. A vertical grid scales to any number
              of spaces without a card ever being clipped at the edge, which the
              sideways strip could not avoid.
            -->
            <ScrollView
                    android:id="@+id/welcomeScroll"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_marginTop="@dimen/sp_6"
                    android:layout_weight="1"
                    android:clipToPadding="false"
                    android:paddingStart="@dimen/sp_3"
                    android:paddingEnd="@dimen/sp_3"
                    android:scrollbars="none">

                <GridLayout
                        android:id="@+id/welcomeCards"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:columnCount="2"
                        android:orientation="horizontal" />
            </ScrollView>

            <!-- Tonal, full width, below the list: a real target, not a link. -->
            <TextView
                    android:id="@+id/welcomeManage"
                    style="@style/DsText.Action"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/gutter"
                    android:layout_marginTop="@dimen/sp_4"
                    android:layout_marginEnd="@dimen/gutter"
                    android:layout_marginBottom="@dimen/sp_6"
                    android:gravity="center"
                    android:minHeight="@dimen/touch_min"
                    android:paddingTop="@dimen/sp_3"
                    android:paddingBottom="@dimen/sp_3"
                    android:text="@string/manage_spaces"
                    android:textColor="@color/ds_on_surface" />
        </LinearLayout>
    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
