<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        xmlns:tools="http://schemas.android.com/tools"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/ds_bg"
        tools:context=".view.main.MainActivity">

    <!-- Ambient light in the current space's colour. Tinted and crossfaded from
         MainActivity whenever the space changes, so the whole screen carries the
         identity of the space you are in. -->
    <View
            android:id="@+id/glow"
            android:layout_width="0dp"
            android:layout_height="340dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

    <include
            android:id="@+id/toolbar_layout"
            layout="@layout/view_toolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toTopOf="parent" />

    <!-- Hero: the space you are in, big enough to be the subject of the screen.
         Tapping anywhere on it opens the space picker. -->
    <LinearLayout
            android:id="@+id/spaceHeader"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="6dp"
            android:layout_marginEnd="16dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="20dp"
            android:paddingTop="18dp"
            android:paddingEnd="16dp"
            android:paddingBottom="18dp"
            android:stateListAnimator="@animator/press_scale"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/toolbar_layout">

        <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

            <TextView
                    android:id="@+id/spaceOverline"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.14"
                    android:text="@string/current_space"
                    android:textAllCaps="true"
                    android:textColor="@color/ds_on_surface_faint"
                    android:textSize="11sp"
                    android:textStyle="bold" />

            <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                <View
                        android:id="@+id/spaceDot"
                        android:layout_width="13dp"
                        android:layout_height="13dp"
                        android:layout_marginEnd="11dp"
                        android:background="@drawable/bg_dot" />

                <TextView
                        android:id="@+id/spaceName"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:letterSpacing="-0.02"
                        android:maxLines="1"
                        android:textColor="@color/ds_on_surface"
                        android:textSize="27sp"
                        android:textStyle="bold"
                        tools:text="Trabalho" />
            </LinearLayout>

            <TextView
                    android:id="@+id/spaceSummary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/ds_on_surface_muted"
                    android:textSize="13sp"
                    tools:text="3 aplicativos · Espaço 1 de 2" />
        </LinearLayout>

        <ImageView
                android:id="@+id/spaceChevron"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_marginStart="8dp"
                android:contentDescription="@string/switch_space"
                android:src="@drawable/ic_chevron_down"
                app:tint="@color/ds_on_surface_muted" />
    </LinearLayout>

    <androidx.viewpager2.widget.ViewPager2
            android:id="@+id/viewPager"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="10dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@id/spaceHeader" />

    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
            android:id="@+id/fab"
            android:layout_width="wrap_content"
            android:layout_height="56dp"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="22dp"
            android:contentDescription="@string/add_app"
            android:text="@string/add_app"
            android:textAllCaps="false"
            android:textSize="15sp"
            android:textStyle="bold"
            app:cornerRadius="20dp"
            app:elevation="10dp"
            app:icon="@drawable/ic_add_24"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintRight_toRightOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
