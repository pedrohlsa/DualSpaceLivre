<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        xmlns:tools="http://schemas.android.com/tools"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/ds_bg"
        tools:context=".view.main.MainActivity">

    <!-- Ambient light in the current space's colour. Tinted and crossfaded from
         MainActivity whenever the space changes, so the whole screen carries the
         identity of the space you are in. -->
    <View
            android:id="@+id/glow"
            android:layout_width="0dp"
            android:layout_height="340dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

    <include
            android:id="@+id/toolbar_layout"
            layout="@layout/view_toolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toTopOf="parent" />

    <!--
      The space panel: the context strip of the workspace.

      Three lines doing three jobs — what this region is, which space, and the
      numbers that place it. The switch action is a labelled control rather than
      a lone chevron, because "tap the card" was something you had to already
      know. Hairline instead of a fill step: it has presence without being a hero
      card, which is right for something you touch occasionally.
    -->
    <LinearLayout
            android:id="@+id/spaceHeader"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/gutter"
            android:layout_marginTop="@dimen/sp_2"
            android:layout_marginEnd="@dimen/gutter"
            android:orientation="vertical"
            android:paddingStart="@dimen/sp_4"
            android:paddingTop="@dimen/sp_3"
            android:paddingEnd="@dimen/sp_3"
            android:paddingBottom="@dimen/sp_4"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/toolbar_layout">

        <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

            <TextView
                    android:id="@+id/spaceOverline"
                    style="@style/DsText.Overline"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/current_space" />

            <TextView
                    android:id="@+id/spaceSwitch"
                    style="@style/DsText.Action"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/ripple_panel_action"
                    android:drawableEnd="@drawable/ic_chevron_down"
                    android:drawablePadding="@dimen/sp_1"
                    android:gravity="center_vertical"
                    android:minHeight="34dp"
                    android:paddingStart="@dimen/sp_3"
                    android:paddingEnd="@dimen/sp_2"
                    android:text="@string/switch_space_action"
                    android:textColor="@color/ds_accent"
                    android:textSize="13sp" />

            <!-- Kept for the code that tints it with the space colour; the label
                 above carries the affordance now. -->
            <ImageView
                    android:id="@+id/spaceChevron"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:contentDescription="@string/switch_space"
                    android:src="@drawable/ic_chevron_down"
                    android:visibility="gone" />
        </LinearLayout>

        <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/sp_2"
                android:gravity="center_vertical"
                android:orientation="horizontal">

            <View
                    android:id="@+id/spaceDot"
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:layout_marginEnd="@dimen/sp_2"
                    android:background="@drawable/bg_dot" />

            <TextView
                    android:id="@+id/spaceName"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:includeFontPadding="false"
                    android:letterSpacing="-0.015"
                    android:maxLines="1"
                    android:textColor="@color/ds_on_surface"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    tools:text="Carolina" />
        </LinearLayout>

        <TextView
                android:id="@+id/spaceSummary"
                style="@style/DsText.Meta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/sp_1"
                android:ellipsize="end"
                android:maxLines="1"
                tools:text="2 aplicativos · Espaço 1 de 8" />
    </LinearLayout>

    <!--
      The apps panel.

      A region with its own header and its own boundary, instead of icons lying
      directly on the background with a floating button in the corner. "Adicionar"
      lives in that header because adding an app is something you do *to this
      section* — a permanent FAB hovering over an empty screen was the single
      most generic thing on the page, and it said nothing about what it added to.
    -->
    <LinearLayout
            android:id="@+id/appsPanel"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginStart="@dimen/gutter"
            android:layout_marginTop="@dimen/sp_4"
            android:layout_marginEnd="@dimen/gutter"
            android:layout_marginBottom="@dimen/sp_5"
            android:background="@drawable/bg_panel"
            android:orientation="vertical"
            android:paddingStart="@dimen/sp_2"
            android:paddingTop="@dimen/sp_3"
            android:paddingEnd="@dimen/sp_2"
            android:paddingBottom="@dimen/sp_2"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/spaceHeader">

        <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="@dimen/sp_3"
                android:paddingEnd="@dimen/sp_1">

            <TextView
                    android:id="@+id/appsSection"
                    style="@style/DsText.Overline"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/apps_section" />

            <!-- The count sits next to the label like a readout, not inside the
                 sentence: this is a workspace panel, and panels report numbers. -->
            <TextView
                    android:id="@+id/appsCount"
                    style="@style/DsText.Overline"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/sp_2"
                    android:layout_weight="1"
                    android:textColor="@color/ds_on_surface_muted"
                    tools:text="2" />

            <TextView
                    android:id="@+id/appsAdd"
                    style="@style/DsText.Action"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/ripple_panel_action"
                    android:drawableStart="@drawable/ic_add_24"
                    android:drawablePadding="@dimen/sp_1"
                    android:gravity="center_vertical"
                    android:minHeight="34dp"
                    android:paddingStart="@dimen/sp_2"
                    android:paddingEnd="@dimen/sp_3"
                    android:text="@string/add_app_short"
                    android:textColor="@color/ds_accent"
                    android:textSize="13sp" />
        </LinearLayout>

        <androidx.viewpager2.widget.ViewPager2
                android:id="@+id/viewPager"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="@dimen/sp_2"
                android:layout_weight="1" />
    </LinearLayout>

    <!-- Welcome screen, shown over everything on launch when there is more than
         one space. Horizontal carousel instead of a vertical list: picking an
         account should feel like choosing a card, not scrolling a menu. -->
    <FrameLayout
            android:id="@+id/welcomeOverlay"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="@color/ds_bg"
            android:clickable="true"
            android:elevation="24dp"
            android:focusable="true"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

        <View
                android:id="@+id/welcomeGlow"
                android:layout_width="match_parent"
                android:layout_height="220dp" />

        <!-- Close: entering the app must never be a dead end. -->
        <ImageView
                android:id="@+id/welcomeClose"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:layout_gravity="top|end"
                android:layout_marginTop="12dp"
                android:layout_marginEnd="12dp"
                android:background="@drawable/ripple_transparent_16"
                android:contentDescription="@string/cancel"
                android:padding="12dp"
                android:src="@drawable/ic_close_24"
                app:tint="@color/ds_on_surface_muted" />

        <!--
          Header sits at the top and the grid takes the room that is left. The
          old layout centred everything, which left a band of dead space above
          and below however many spaces existed.
        -->
        <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:paddingTop="72dp">

            <TextView
                    android:id="@+id/welcomeTitle"
                    style="@style/DsText.Display"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="@dimen/gutter"
                    android:paddingEnd="@dimen/gutter"
                    android:text="@string/welcome_title"
                    android:textSize="32sp" />

            <TextView
                    android:id="@+id/welcomeSubtitle"
                    style="@style/DsText.Support"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/sp_1"
                    android:paddingStart="@dimen/gutter"
                    android:paddingEnd="@dimen/gutter"
                    android:text="@string/welcome_subtitle"
                    android:textSize="14sp" />

            <!--
              Two columns, flowing downwards. A vertical grid scales to any number
              of spaces without a card ever being clipped at the edge, which the
              sideways strip could not avoid.
            -->
            <!--
              Two columns, flowing downwards, with the secondary action riding
              along at the end of them. Pinning it to the bottom left a band of
              nothing between the last card and the button that read as a missing
              component; "Gerenciar espaços" is not a CTA that has to stay in
              reach at all times, so it simply follows the content.
            -->
            <ScrollView
                    android:id="@+id/welcomeScroll"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_marginTop="@dimen/sp_6"
                    android:layout_weight="1"
                    android:clipToPadding="false"
                    android:paddingStart="@dimen/sp_3"
                    android:paddingEnd="@dimen/sp_3"
                    android:paddingBottom="@dimen/sp_6"
                    android:scrollbars="none">

                <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                    <!--
                      One block holding every space, rather than nine cards on a
                      background. The entries inside it carry no fill of their
                      own: this is a choice screen, and a frame per option is the
                      management screen's job, not this one. The monogram is the
                      visual weight here.
                    -->
                    <GridLayout
                            android:id="@+id/welcomeCards"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_block"
                            android:columnCount="2"
                            android:orientation="horizontal"
                            android:padding="@dimen/sp_2" />

                    <TextView
                            android:id="@+id/welcomeManage"
                            style="@style/DsText.Action"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/sp_1"
                            android:layout_marginTop="@dimen/sp_3"
                            android:layout_marginEnd="@dimen/sp_1"
                            android:gravity="center"
                            android:minHeight="@dimen/touch_min"
                            android:paddingTop="@dimen/sp_3"
                            android:paddingBottom="@dimen/sp_3"
                            android:text="@string/manage_spaces"
                            android:textColor="@color/ds_on_surface_muted" />
                </LinearLayout>
            </ScrollView>
        </LinearLayout>
    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
