<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        xmlns:tools="http://schemas.android.com/tools"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/ds_bg"
        tools:context=".view.main.MainActivity">

    <!-- Ambient light in the current space's colour. Tinted and crossfaded from
         MainActivity whenever the space changes, so the whole screen carries the
         identity of the space you are in. -->
    <View
            android:id="@+id/glow"
            android:layout_width="0dp"
            android:layout_height="340dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

    <include
            android:id="@+id/toolbar_layout"
            layout="@layout/view_toolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toTopOf="parent" />

    <!--
      One workspace surface.

      Two stacked cards described two things that happened to be on the same
      screen. This is the space, and the apps inside it — the same relationship
      the product is about — so it is one region, divided internally by a
      hairline rather than by a gap between two containers.

      It wraps its content. Whatever is left below is background, and the
      composition is finished at the top instead of being stretched to fill.
    -->
    <LinearLayout
            android:id="@+id/appsPanel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/gutter"
            android:layout_marginTop="@dimen/sp_3"
            android:layout_marginEnd="@dimen/gutter"
            android:background="@drawable/bg_panel"
            android:orientation="vertical"
            android:paddingTop="@dimen/sp_4"
            android:paddingBottom="@dimen/sp_2"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/toolbar_layout">

        <!-- Which space this is. Tapping anywhere on it opens the picker. -->
        <LinearLayout
                android:id="@+id/spaceHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="@dimen/sp_4"
                android:paddingEnd="@dimen/sp_3">

            <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                <TextView
                        android:id="@+id/spaceOverline"
                        style="@style/DsText.Overline"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/current_space" />

                <TextView
                        android:id="@+id/spaceSwitch"
                        style="@style/DsText.Action"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/ripple_transparent_16"
                        android:drawableEnd="@drawable/ic_chevron_down"
                        android:drawablePadding="@dimen/sp_1"
                        android:gravity="center_vertical"
                        android:minHeight="36dp"
                        android:paddingStart="@dimen/sp_2"
                        android:paddingEnd="@dimen/sp_2"
                        android:text="@string/switch_space_action"
                        android:textColor="@color/ds_accent"
                        android:textSize="13sp" />

                <ImageView
                        android:id="@+id/spaceChevron"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:contentDescription="@string/switch_space"
                        android:src="@drawable/ic_chevron_down"
                        android:visibility="gone" />
            </LinearLayout>

            <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/sp_2"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                <View
                        android:id="@+id/spaceDot"
                        android:layout_width="10dp"
                        android:layout_height="10dp"
                        android:layout_marginEnd="@dimen/sp_2"
                        android:background="@drawable/bg_dot" />

                <TextView
                        android:id="@+id/spaceName"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:includeFontPadding="false"
                        android:letterSpacing="-0.015"
                        android:maxLines="1"
                        android:textColor="@color/ds_on_surface"
                        android:textFontWeight="600"
                        android:textSize="21sp"
                        tools:text="Carolina" />
            </LinearLayout>

            <!--
              Lifted off the tertiary token: this is the line that tells you which
              space you are in and where it sits, which is not decoration. Meta
              stays faint for things that genuinely are.
            -->
            <TextView
                    android:id="@+id/spaceSummary"
                    style="@style/DsText.Meta"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/sp_1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/ds_on_surface_muted"
                    android:textSize="13sp"
                    tools:text="2 aplicativos · Espaço 1 de 8" />
        </LinearLayout>

        <!-- Divides the region, rather than separating two regions. -->
        <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/hairline"
                android:layout_marginStart="@dimen/sp_4"
                android:layout_marginTop="@dimen/sp_4"
                android:layout_marginEnd="@dimen/sp_4"
                android:background="@color/ds_outline" />

        <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="@dimen/sp_4"
                android:paddingTop="@dimen/sp_4"
                android:paddingEnd="@dimen/sp_4">

            <!--
              The count reads as part of the label, not as a value in a column.
              Pinned to the far edge it looked like a table cell; beside the word,
              at the same weight and size, it is just the rest of the sentence.
            -->
            <TextView
                    android:id="@+id/appsSection"
                    style="@style/DsText.Overline"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/apps_section" />

            <TextView
                    android:id="@+id/appsCount"
                    style="@style/DsText.Overline"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:textColor="@color/ds_on_surface_muted"
                    tools:text="· 2" />
        </LinearLayout>

        <androidx.viewpager2.widget.ViewPager2
                android:id="@+id/viewPager"
                android:layout_width="match_parent"
                android:layout_height="200dp"
                android:layout_marginTop="@dimen/sp_2" />

        <!--
          An editorial action, not a button.

          A tonal capsule around a recurring action is the design-system reflex,
          and it reads as a component someone dropped in. Text, a glyph and a
          ripple say the same thing and let the panel stay quiet.
        -->
        <TextView
                android:id="@+id/appsAdd"
                style="@style/DsText.Action"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/ripple_transparent_16"
                android:drawableStart="@drawable/ic_add_24"
                android:drawablePadding="@dimen/sp_2"
                android:gravity="center_vertical"
                android:minHeight="@dimen/touch_min"
                android:paddingStart="@dimen/sp_4"
                android:paddingEnd="@dimen/sp_4"
                android:text="@string/add_app"
                android:textColor="@color/ds_accent" />
    </LinearLayout>

    <!-- Welcome screen, shown over everything on launch when there is more than
         one space. Horizontal carousel instead of a vertical list: picking an
         account should feel like choosing a card, not scrolling a menu. -->
    <FrameLayout
            android:id="@+id/welcomeOverlay"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="@color/ds_bg"
            android:clickable="true"
            android:elevation="24dp"
            android:focusable="true"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

        <View
                android:id="@+id/welcomeGlow"
                android:layout_width="match_parent"
                android:layout_height="220dp" />

        <!-- Close: entering the app must never be a dead end. -->
        <ImageView
                android:id="@+id/welcomeClose"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:layout_gravity="top|end"
                android:layout_marginTop="12dp"
                android:layout_marginEnd="12dp"
                android:background="@drawable/ripple_transparent_16"
                android:contentDescription="@string/cancel"
                android:padding="12dp"
                android:src="@drawable/ic_close_24"
                app:tint="@color/ds_icon" />

        <!--
          Header sits at the top and the grid takes the room that is left. The
          old layout centred everything, which left a band of dead space above
          and below however many spaces existed.
        -->
        <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:paddingTop="72dp">

            <TextView
                    android:id="@+id/welcomeTitle"
                    style="@style/DsText.Display"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:paddingStart="@dimen/gutter"
                    android:paddingEnd="@dimen/gutter"
                    android:text="@string/welcome_title"
                    android:textSize="32sp" />

            <TextView
                    android:id="@+id/welcomeSubtitle"
                    style="@style/DsText.Support"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/sp_1"
                    android:gravity="center_horizontal"
                    android:paddingStart="@dimen/gutter"
                    android:paddingEnd="@dimen/gutter"
                    android:text="@string/welcome_subtitle"
                    android:textSize="14sp" />

            <!--
              Two columns, flowing downwards. A vertical grid scales to any number
              of spaces without a card ever being clipped at the edge, which the
              sideways strip could not avoid.
            -->
            <!--
              Two columns, flowing downwards, with the secondary action riding
              along at the end of them. Pinning it to the bottom left a band of
              nothing between the last card and the button that read as a missing
              component; "Gerenciar espaços" is not a CTA that has to stay in
              reach at all times, so it simply follows the content.
            -->
            <ScrollView
                    android:id="@+id/welcomeScroll"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_marginTop="@dimen/sp_6"
                    android:layout_weight="1"
                    android:clipToPadding="false"
                    android:paddingStart="@dimen/sp_3"
                    android:paddingEnd="@dimen/sp_3"
                    android:paddingBottom="@dimen/sp_6"
                    android:scrollbars="none">

                <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                    <!--
                      One block holding every space, rather than nine cards on a
                      background. The entries inside it carry no fill of their
                      own: this is a choice screen, and a frame per option is the
                      management screen's job, not this one. The monogram is the
                      visual weight here.
                    -->
                    <GridLayout
                            android:id="@+id/welcomeCards"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_block"
                            android:columnCount="2"
                            android:orientation="horizontal"
                            android:padding="@dimen/sp_2" />

                    <TextView
                            android:id="@+id/welcomeManage"
                            style="@style/DsText.Action"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/sp_1"
                            android:layout_marginTop="@dimen/sp_3"
                            android:layout_marginEnd="@dimen/sp_1"
                            android:gravity="center"
                            android:minHeight="@dimen/touch_min"
                            android:paddingTop="@dimen/sp_3"
                            android:paddingBottom="@dimen/sp_3"
                            android:text="@string/manage_spaces"
                            android:textColor="@color/ds_on_surface_muted" />
                </LinearLayout>
            </ScrollView>
        </LinearLayout>
    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
