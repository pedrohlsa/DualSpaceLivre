<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        xmlns:tools="http://schemas.android.com/tools"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/ds_bg"
        tools:context=".view.main.MainActivity">

    <include
            android:id="@+id/toolbar_layout"
            layout="@layout/view_toolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toTopOf="parent" />

    <!-- Current space card. Doubles as the entry point for the space picker,
         so the active space is always visible and one tap away. -->
    <LinearLayout
            android:id="@+id/spaceHeader"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="4dp"
            android:layout_marginEnd="16dp"
            android:background="@drawable/ripple_card"
            android:gravity="center_vertical"
            android:minHeight="64dp"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingTop="12dp"
            android:paddingEnd="12dp"
            android:paddingBottom="12dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/toolbar_layout">

        <View
                android:id="@+id/spaceDot"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_marginEnd="14dp"
                android:background="@drawable/bg_dot" />

        <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

            <TextView
                    android:id="@+id/spaceName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/ds_on_surface"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    tools:text="Trabalho" />

            <TextView
                    android:id="@+id/spaceSummary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/ds_on_surface_muted"
                    android:textSize="13sp"
                    tools:text="3 aplicativos · Espaço 1 de 2" />
        </LinearLayout>

        <ImageView
                android:id="@+id/spaceChevron"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:contentDescription="@string/switch_space"
                android:src="@drawable/ic_chevron_down"
                app:tint="@color/ds_on_surface_muted" />
    </LinearLayout>

    <androidx.viewpager2.widget.ViewPager2
            android:id="@+id/viewPager"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="8dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@id/spaceHeader" />

    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
            android:id="@+id/fab"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="20dp"
            android:contentDescription="@string/add_app"
            android:text="@string/add_app"
            android:textAllCaps="false"
            android:textColor="@color/ds_on_brand"
            android:textSize="15sp"
            app:backgroundTint="@color/ds_violet"
            app:cornerRadius="18dp"
            app:elevation="6dp"
            app:icon="@drawable/ic_add_24"
            app:iconTint="@color/ds_on_brand"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintRight_toRightOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
