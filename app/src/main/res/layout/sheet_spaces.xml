<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_sheet"
        android:orientation="vertical"
        android:paddingBottom="16dp">

    <View
            android:layout_width="38dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_sheet_handle" />

    <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:letterSpacing="-0.02"
            android:paddingStart="22dp"
            android:paddingTop="18dp"
            android:paddingEnd="22dp"
            android:text="@string/spaces_title"
            android:textColor="@color/ds_on_surface"
            android:textSize="26sp"
            android:textStyle="bold" />

    <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="22dp"
            android:paddingTop="4dp"
            android:paddingEnd="22dp"
            android:paddingBottom="8dp"
            android:text="@string/spaces_subtitle"
            android:textColor="@color/ds_on_surface_muted"
            android:textSize="13sp" />

    <ScrollView
            android:id="@+id/spacesScroll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:scrollbars="none">

        <LinearLayout
                android:id="@+id/spacesContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="14dp"
                android:paddingEnd="14dp" />
    </ScrollView>

    <!-- Pinned outside the scroll view so it stays reachable no matter how many
         spaces the user has. -->
    <FrameLayout
            android:id="@+id/spacesFooter"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="14dp"
            android:paddingEnd="14dp" />

</LinearLayout>
