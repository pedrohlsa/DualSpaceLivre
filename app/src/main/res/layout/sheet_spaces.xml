<?xml version="1.0" encoding="utf-8"?>
<!--
  "Seus espaços".

  Title and rows share one gutter so the eye has a single left edge to follow.
  The create action is pinned outside the scroll view: with eight spaces the list
  scrolls, and the one action that is always relevant must never scroll away.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_sheet"
        android:orientation="vertical"
        android:paddingBottom="@dimen/sp_2">

    <View
            android:layout_width="32dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="@dimen/sp_3"
            android:background="@drawable/bg_sheet_handle" />

    <TextView
            style="@style/DsText.Title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="@dimen/gutter"
            android:paddingTop="@dimen/sp_5"
            android:paddingEnd="@dimen/gutter"
            android:text="@string/spaces_title" />

    <TextView
            style="@style/DsText.Support"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="@dimen/gutter"
            android:paddingTop="@dimen/sp_1"
            android:paddingEnd="@dimen/gutter"
            android:paddingBottom="@dimen/sp_3"
            android:text="@string/spaces_subtitle" />

    <ScrollView
            android:id="@+id/spacesScroll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:scrollbars="none">

        <LinearLayout
                android:id="@+id/spacesContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="@dimen/sp_3"
                android:paddingEnd="@dimen/sp_3"
                android:paddingBottom="@dimen/sp_2" />
    </ScrollView>

    <FrameLayout
            android:id="@+id/spacesFooter"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="@dimen/sp_3"
            android:paddingTop="@dimen/sp_1"
            android:paddingEnd="@dimen/sp_3" />

</LinearLayout>
