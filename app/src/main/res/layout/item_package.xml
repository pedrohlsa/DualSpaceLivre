<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        xmlns:tools="http://schemas.android.com/tools"
        android:id="@+id/packageRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/ripple_transparent_16"
        android:gravity="center_vertical"
        android:minHeight="72dp"
        android:orientation="horizontal"
        android:paddingStart="@dimen/sp_3"
        android:paddingTop="@dimen/sp_2"
        android:paddingEnd="@dimen/sp_2"
        android:paddingBottom="@dimen/sp_2"
        android:stateListAnimator="@animator/press_scale">

    <FrameLayout
            android:layout_width="50dp"
            android:layout_height="50dp">

        <!-- No container: adaptive icons carry their own shape, and the box only
             shrank the artwork it was framing. -->
        <ImageView
                android:id="@+id/icon"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:layout_gravity="center"
                android:contentDescription="@null" />

        <!-- Kept because the adapter still binds it; the "already added" state is
             shown by the badge below instead. -->
        <com.othershe.cornerlabelview.CornerLabelView
                android:id="@+id/cornerLabel"
                android:layout_width="1dp"
                android:layout_height="1dp"
                android:visibility="gone"
                app:bg_color="@color/ds_violet"
                app:position="left_top"
                app:side_length="1dp"
                app:text="*" />
    </FrameLayout>

    <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical">

        <TextView
                android:id="@+id/name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/ds_on_surface"
                android:textSize="16sp"
                tools:text="Instagram" />

        <TextView
                android:id="@+id/packageName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/ds_on_surface_faint"
                android:textSize="12sp"
                tools:text="com.instagram.android" />

        <TextView
                android:id="@+id/installedBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_badge"
                android:paddingStart="9dp"
                android:paddingTop="3dp"
                android:paddingEnd="9dp"
                android:paddingBottom="3dp"
                android:text="@string/already_in_space"
                android:textColor="@color/ds_violet"
                android:textSize="11sp"
                android:textStyle="bold"
                android:visibility="gone" />
    </LinearLayout>

    <CheckBox
            android:id="@+id/checkbox"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:clickable="false"
            android:focusable="false"
            android:scaleX="1.15"
            android:scaleY="1.15"
            app:buttonTint="@color/ds_violet" />

</LinearLayout>
