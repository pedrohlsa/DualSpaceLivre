<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:id="@+id/cardRoot"
        android:layout_width="170dp"
        android:layout_height="98dp"
        android:background="@drawable/bg_glass_card_sm"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:stateListAnimator="@animator/press_scale">

    <ImageView
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:contentDescription="@string/new_space"
            android:src="@drawable/ic_add_space_24"
            app:tint="@color/ds_violet" />

    <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:text="@string/new_space_short"
            android:textColor="@color/ds_violet"
            android:textSize="16sp"
            android:textStyle="bold" />
</LinearLayout>
