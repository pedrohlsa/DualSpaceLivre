<?xml version="1.0" encoding="utf-8"?>
<!--
  "Novo espaço" in the welcome block.

  It shares the block with the real spaces, so it cannot be told apart by having
  a frame — inside a block that would be a box in a box. It is told apart by what
  it contains: the product's lavender on the glyph and the label, where every
  real space carries its own colour. Same shape, different role.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:id="@+id/cardRoot"
        android:layout_width="170dp"
        android:layout_height="98dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/sp_2"
        android:paddingEnd="@dimen/sp_2"
        android:stateListAnimator="@animator/press_scale">

    <FrameLayout
            android:layout_width="@dimen/avatar_md"
            android:layout_height="@dimen/avatar_md">

        <View
                android:id="@+id/addSlot"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

        <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:contentDescription="@string/new_space"
                android:src="@drawable/ic_add_24"
                app:tint="@color/ds_accent" />
    </FrameLayout>

    <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/sp_3"
            android:layout_weight="1"
            android:orientation="vertical">

        <TextView
                style="@style/DsText.Item"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/new_space_short"
                android:textColor="@color/ds_accent" />

        <TextView
                style="@style/DsText.Meta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:maxLines="2"
                android:text="@string/new_space_card_hint" />
    </LinearLayout>
</LinearLayout>
